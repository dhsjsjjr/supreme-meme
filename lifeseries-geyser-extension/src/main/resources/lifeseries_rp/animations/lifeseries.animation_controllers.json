{
  "format_version": "1.10.0",
  "animation_controllers": {

    "controller.animation.lifeseries.snail": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "flying": "v.is_flying" },
            { "gliding": "v.is_gliding" },
            { "walking": "query.modified_move_speed > 0.01" }
          ]
        },
        "walking": {
          "animations": ["walk"],
          "transitions": [
            { "flying": "v.is_flying" },
            { "gliding": "v.is_gliding" },
            { "idle": "query.modified_move_speed <= 0.01" }
          ]
        },
        "flying": {
          "animations": ["fly"],
          "transitions": [
            { "idle": "!v.is_flying && !v.is_gliding" },
            { "gliding": "v.is_gliding" }
          ]
        },
        "gliding": {
          "animations": ["glide"],
          "transitions": [
            { "idle": "!v.is_gliding" }
          ]
        }
      }
    },

    "controller.animation.lifeseries.triviabot": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "gliding": "v.is_gliding" },
            { "waving": "v.is_waving" },
            { "walking": "query.modified_move_speed > 0.01" }
          ]
        },
        "walking": {
          "animations": ["walk"],
          "transitions": [
            { "gliding": "v.is_gliding" },
            { "idle": "query.modified_move_speed <= 0.01" }
          ]
        },
        "gliding": {
          "animations": ["glide"],
          "transitions": [
            { "idle": "!v.is_gliding" }
          ]
        },
        "waving": {
          "animations": ["wave"],
          "transitions": [
            { "idle": "!v.is_waving" }
          ]
        }
      }
    },

    "controller.animation.lifeseries.angrysnowman": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            { "walking": "query.modified_move_speed > 0.01" }
          ]
        },
        "walking": {
          "animations": ["walk"],
          "transitions": [
            { "idle": "query.modified_move_speed <= 0.01" }
          ]
        }
      }
    }

  }
}
